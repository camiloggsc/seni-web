# Copia este archivo como .env.local para desarrollo,
# y carga la misma variable en el panel de tu hosting para produccion.

# A donde se mandan los prospectos del formulario de contacto.
# Puede ser un webhook de Zapier, Make, n8n, o tu propio endpoint.
# SIN ESTA VARIABLE el formulario responde error 503 en produccion a
# proposito: es preferible que la persona vea el fallo y escriba por
# Instagram a que su mensaje se pierda en silencio.
CONTACT_WEBHOOK_URL=
